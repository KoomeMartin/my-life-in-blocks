# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and fill in your actual values
# Note: secrets.toml is gitignored for security

# OpenAI API Configuration
OPENAI_API_KEY = "sk-proj-your-openai-api-key-here"

# Supabase Configuration
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_ANON_KEY = "your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY = "your-supabase-service-role-key-here"

# LangSmith Configuration (Optional)
LANGCHAIN_TRACING_V2 = "true"
LANGCHAIN_ENDPOINT = "https://api.smith.langchain.com"
LANGCHAIN_API_KEY = "lsv2_pt_your-langsmith-api-key-here"
LANGCHAIN_PROJECT = "my_life_in_blocks"
